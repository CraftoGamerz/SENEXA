# Used by Docker Compose and the gateway, never committed with actual values.
SENEXA_GATEWAY_TOKEN=replace-with-at-least-32-random-characters
SENEXA_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional broker bridge. Configure broker authentication separately.
# SENEXA_MQTT_HOST=192.168.1.10
# SENEXA_MQTT_PORT=8883
# SENEXA_MQTT_TLS=1
# SENEXA_MQTT_USERNAME=senexa-gateway
# SENEXA_MQTT_PASSWORD=your-broker-password
# SENEXA_MQTT_TOPIC=senexa/+/telemetry
